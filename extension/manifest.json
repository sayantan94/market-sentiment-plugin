{
  "manifest_version": 3,
  "name": "Market Sentiment Plugin",
  "version": "1.0.0",
  "description": "Save X posts with $TICKER mentions for sentiment analysis",
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Market Sentiment"
  },
  "icons": {}
}
